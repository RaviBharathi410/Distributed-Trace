# DistributedTrace — Environment Configuration
# Copy this file to .env for local development

# Server Configuration
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
ENVIRONMENT=development
ALLOWED_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# PostgreSQL (Control Plane: Users, Orgs, API Keys, Settings)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/distributedtrace?sslmode=disable

# ClickHouse (Telemetry Data: Spans, Anomalies, Hourly Metrics)
CLICKHOUSE_URL=127.0.0.1:9000
CLICKHOUSE_DB=default

# Redis (Tail Sampling & Buffer Management)
REDIS_URL=redis://localhost:6379

# Kafka / Redpanda (Span Ingestion Bus)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_SPANS=otel-spans
KAFKA_MIN_BYTES=10240
KAFKA_ALLOW_AUTO_TOPIC_CREATION=false
KAFKA_ANALYSIS_WORKERS=2
KAFKA_ANALYSIS_QUEUE_CAPACITY=32

# JWT Key Pair (Leave empty in development for automatic ephemeral key pair generation)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Rate Limiting & WebSocket Limits
MAX_WS_CONNECTIONS=1000
RATE_LIMIT_AUTH=10
RATE_LIMIT_API=300

# AWS (Only required when ENVIRONMENT=production)
AWS_REGION=us-east-1
AWS_SECRETS_ARN=
